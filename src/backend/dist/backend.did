type WhiteboardAction = 
 record {
   color: text;
   id: nat;
   kind: text;
   points: vec float64;
   senderName: text;
   timestamp: int;
   width: float64;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type TimerState = 
 record {
   durationSec: nat;
   running: bool;
   startTime: int;
 };
type StickerState = 
 record {
   studentName: text;
   symbol: text;
 };
type SpotlightState = 
 record {
   active: bool;
   studentName: text;
 };
type Session = 
 record {
   createdAt: Timestamp;
   email: Email;
   name: text;
   role: Role;
   token: text;
 };
type Role = 
 variant {
   student;
   teacher;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ReactionEvent = 
 record {
   id: nat;
   senderName: text;
   symbol: text;
   timestamp: int;
 };
type Password = text;
type LoginResult = 
 variant {
   invalidCredentials;
   ok: Session;
 };
type FileRef = 
 record {
   mimeType: text;
   name: text;
   size: nat;
   url: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Email = text;
type ClassroomView = 
 record {
   createdAt: Timestamp;
   duration: ClassroomDuration;
   id: ClassroomId;
   onlineCount: nat;
   roomCode: text;
   title: text;
 };
type ClassroomId = nat;
type ClassroomDuration = 
 variant {
   hour1;
   hour1half;
   min30;
 };
type ChatMessage = 
 record {
   file: opt FileRef;
   id: nat;
   isSystem: bool;
   senderName: text;
   "text": text;
   timestamp: int;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  broadcastWhiteboardAction: (kind: text, points: vec float64, color: 
   text, width: float64) -> ();
  createClassroom: (title: text, duration: ClassroomDuration) ->
   (ClassroomView);
  deleteClassroom: (id: ClassroomId) -> (bool);
  endSession: (roomCode: text) -> ();
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getCurrentSession: (token: text) -> (opt Session) query;
  getOnline: (roomCode: text) -> (vec principal) query;
  getRoomLink: (id: ClassroomId) -> (opt text) query;
  getSessionEnded: (roomCode: text) -> (bool) query;
  getSpotlight: () -> (SpotlightState) query;
  getSticker: () -> (StickerState) query;
  getTimer: () -> (TimerState) query;
  isCallerAdmin: () -> (bool) query;
  joinRoom: (roomCode: text) -> ();
  leaveRoom: (roomCode: text) -> ();
  listChatMessages: () -> (vec ChatMessage) query;
  listClassrooms: () -> (vec ClassroomView) query;
  listReactions: () -> (vec ReactionEvent) query;
  listWhiteboardActions: () -> (vec WhiteboardAction) query;
  login: (email: Email, password: Password) -> (LoginResult);
  logout: (token: text) -> ();
  schema: () -> (text) query;
  searchClassrooms: (keyword: text, date: opt Timestamp) ->
   (vec ClassroomView) query;
  sendChatMessage: ("text": text, file: opt FileRef) -> (nat);
  sendReaction: (symbol: text) -> (nat);
  setSpotlight: (studentName: text) -> ();
  setSticker: (studentName: text, symbol: text) -> ();
  setTimer: (durationSec: nat) -> ();
}
